  "main": "index.js",
  "scripts": {
    "build": "run-s clean build:tsc build:bundle",
    "build:tsc": "tsc",
    "build:bundle": "webpack-cli",
    "build:bundle:dev-check": "cross-env OUTPUT_PATH=./.tmp-webpack-check webpack-cli",
    "clean": "rimraf ./dist-esm",
    "clean:tmp-webpack-check": "rimraf ./.tmp-webpack-check",
    "production-build": "cross-env NODE_ENV=production DEPLOY=1 npm run build",
    "test:manual-build": "npm run build:tsc && npm run build:bundle:dev-check && npm run clean:tmp-webpack-check",
    "watch": "run-p watch:tsc watch:bundle",
    "watch:bundle:dev-check": "cross-env OUTPUT_PATH=./.tmp-webpack-check webpack-cli --watch",
    "watch:tsc": "tsc --watch --pretty",
    "watch:bundle": "webpack-cli --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
